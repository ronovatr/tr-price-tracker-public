# Educational price-tracker skeleton - configuration
#
# Copy to .env and fill placeholders. Never commit real secrets.
# This project does NOT target live retail websites by default.

# Optional Telegram (demo alerts only - leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite path (relative or absolute)
DATABASE_PATH=data/demo_tracker.db

# Politeness
MIN_REQUEST_GAP_SECONDS=8
HARD_DENY_STREAK=2
HARD_DENY_COOLDOWN_SECONDS=3600

# Demo mode: only local fixtures + fictional ExampleMart (default true)
DEMO_FIXTURES_ONLY=true
